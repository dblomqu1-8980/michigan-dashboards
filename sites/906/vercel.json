{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?blomblog\\.com"
        }
      ],
      "destination": "https://906dashboard.com/:path*",
      "permanent": true
    },
    {
      "source": "/agatefalls.html",
      "destination": "/waterfalls.html",
      "permanent": true
    },
    {
      "source": "/Agate_Falls_Scenic_Site.html",
      "destination": "/waterfalls.html",
      "permanent": true
    },
    {
      "source": "/agate%20falls.shtml",
      "destination": "/waterfalls.html",
      "permanent": true
    },
    {
      "source": "/agate falls.shtml",
      "destination": "/waterfalls.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
